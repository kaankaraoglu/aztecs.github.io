# Warcraft Logs API credentials (used by build-time fetch scripts)
# Register an app at https://www.warcraftlogs.com/api/clients/ to get these
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Firebase Analytics (only used in production builds)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Refresh Worker + Turnstile (powers the "Refresh data" button on the raid box)
VITE_REFRESH_WORKER_URL=
VITE_TURNSTILE_SITE_KEY=

# Optional build flags — leave commented out unless you want the behaviour
# SKIP_DATA_FETCH=true   # skip the predev/prebuild WCL+RIO fetch (CI sets this)
# SKIP_RIO_FETCH=true    # skip only the Raider.IO fetch
# WCL_REPORT_LIMIT=50    # reports per zone the WCL fetchers scan
