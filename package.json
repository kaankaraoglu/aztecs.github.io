{
  "name": "aztecs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch-data": "node scripts/fetch-wcl-data.js && node scripts/fetch-rio-data.js && node scripts/fetch-wcl-stats.js",
    "predev": "node -e \"if(!process.env.SKIP_DATA_FETCH){process.exit(1)}\" || npm run fetch-data",
    "dev": "vite",
    "prebuild": "node -e \"if(!process.env.SKIP_DATA_FETCH){process.exit(1)}\" || npm run fetch-data",
    "build": "vite build",
    "build:analyze": "ANALYZE=1 vite build",
    "postbuild": "node scripts/postbuild.js",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@lucide/vue": "^1.23.0",
    "@tailwindcss/vite": "^4.2.4",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "reka-ui": "^2.9.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.41",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "~10.9.1",
    "globals": "^17.6.0",
    "husky": "^9.1.6",
    "jsdom": "^29.0.2",
    "lint-staged": "^17.0.8",
    "prettier": "3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.100.0",
    "sharp": "^0.35.3",
    "vite": "^8.1.4",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "vite-plugin-vue-devtools": {
      "vite-plugin-inspect": {
        "vite": "$vite"
      }
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,scss,css,md,json,yml,yaml}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
