{
  "name": "aztecs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch-data": "node scripts/fetch-wcl-data.js && node scripts/fetch-rio-data.js && node scripts/fetch-wcl-stats.js",
    "predev": "npm run fetch-data",
    "dev": "vite",
    "prebuild": "npm run fetch-data",
    "build": "vite build",
    "postbuild": "cp dist/index.html dist/404.html || copy dist/index.html dist/404.html",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.11.0",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.9.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.31",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "~10.5.0",
    "globals": "^16.4.0",
    "husky": "^9.1.6",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.2.6",
    "prettier": "3.8.1",
    "sass-embedded": "^1.99.0",
    "sharp": "^0.34.5",
    "vite": "^8.0.8",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,scss,css,md,json,yml,yaml}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
